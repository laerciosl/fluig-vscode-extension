{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "out",
		"lib": [
			"es6"
		],
		"sourceMap": true,
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@fluiggers/sdk": ["packages/sdk/src/index.ts"],
			"@fluiggers/sdk/*": ["packages/sdk/src/*"]
		}
	},
	"exclude": [
		"node_modules",
		".vscode-test",
		"packages"
	]
}
