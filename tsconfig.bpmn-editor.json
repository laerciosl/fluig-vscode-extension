{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "module": "esnext",
        "moduleResolution": "node",
        "target": "es2020",
        "lib": ["es2020", "dom"],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src/core/views/bpmn/**/*.ts"
    ]
}
